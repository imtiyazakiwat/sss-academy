# Firebase service account JSON, base64-encoded.
#
# Base64 rather than raw JSON so the multi-line private key survives Vercel's
# environment variable UI intact. Generate it with:
#
#   base64 -i service-account.json | pbcopy
#
# Optional. Without it the site still renders every page from the static content
# modules — only enquiry capture, the notice bar and the admin dashboard are
# inactive.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Web API key. Project settings -> General -> Web API Key.
#
# Used server-side only, for the Identity Toolkit password sign-in call behind
# the admin login form. It is designed to be public, but there is no reason to
# ship it to the browser, so it is not NEXT_PUBLIC_.
#
# Required for /admin/login to work.
FIREBASE_WEB_API_KEY=

# Absolute site origin. Used for absolute links out of the dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail / SMTP Email Configuration
# Generate an App Password for your Google account: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@sssacademy.in
SMTP_PASS=your-16-char-app-password
SMTP_FROM="SSS Academy <info@sssacademy.in>"

# Optional: Override recipient email for new contact form notifications (defaults to SMTP_USER or contact.email)
NOTIFICATION_EMAIL=info@sssacademy.in
